{
  "$schema": "https://opencode.ai/config.json",
  "model": "scaleway-2/glm-5.2",
  "provider": {
    "Codex-Iliad": {
      "name": "Codex Iliad",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://iliad.codix.scw.eu/v1",
        "apiKey": "{env:CODEX_ILIAD_API_KEY}"
      },
      "models": {
        "Devstral2-123B": { "name": "Devstral 2 123B" },
        "codiX-agent": {
          "name": "codiX agent",
          "limit": { "context": 250000, "input": 250000, "output": 16000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "Qwen3.5-397B-A17B": {},
        "Qwen3.6-35B-A3B": {}
      }
    },
    "scaleway-2": {
      "name": "Scaleway (local)",
      "options": {
        "baseURL": "https://api.scaleway.ai/{env:SCW_PROJECT_ID}/v1",
        "apiKey": "{env:SCW_SECRET_KEY}"
      },
      "models": {
        "glm-5.2": {}
      }
    }
  }
}
