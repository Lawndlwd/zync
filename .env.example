# Copy into Dokploy → your compose app → Environment (or into .env for local runs).

# ── App ──────────────────────────────────────────────────────────────────────
# Public address of the app. In Dokploy → Domains point this host at service `api`, port 3001.
# (The AI chat is served through the app; opencode needs no domain.) Used in notification links.
APP_URL=https://zync.example.com

# Host folder whose subfolders are your workspaces. Created/fixed for the app's user on start.
WORKSPACES_HOST_DIR=/srv/zync/workspaces

# Timezone for job schedules, unless a job sets its own.
TZ=Europe/Paris

# ── Access ───────────────────────────────────────────────────────────────────
# zync has no login yet: anyone who can reach APP_URL can use your files and the AI.
# The app only starts once you acknowledge that with 1 (put it behind a VPN or access control).
ALLOW_NO_AUTH=0

# ── AI providers ─────────────────────────────────────────────────────────────
# Referenced as {env:NAME} in opencode/opencode.json (the AI server config seed).
CODEX_ILIAD_API_KEY=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
# opencode's built-in providers read these directly; set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Scheduled runs are aborted after this many minutes.
JOB_TIMEOUT_MIN=30

# Push notifications via ntfy (https://ntfy.sh or self-hosted). Empty NTFY_TOPIC = off.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
