# Copy into Dokploy → your compose app → Environment (or into .env for local runs).

# Base domain. The app is served at ai-app.$DOMAIN and the chat at ai.$DOMAIN (set both in Dokploy → Domains).
# Point both DNS records at the Dokploy server.
DOMAIN=example.com

# Basic auth for BOTH hosts (required; the containers refuse to start without it).
# Generate:  htpasswd -nbB admin 'your-password'
# Then double every "$", e.g. admin:$$2y$$05$$abc...
BASIC_AUTH_USERS=

# Absolute host folder whose subfolders are your workspaces (must be writable by uid 1000).
WORKSPACES_HOST_DIR=/srv/zync/workspaces

# Timezone used for job schedules unless a job sets its own.
TZ=Europe/Paris

# AI provider keys — set the ones you use (or log in from the chat UI settings).
# Keys referenced as {env:…} in opencode/opencode.json (the AI server config template).
CODEX_ILIAD_API_KEY=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Notifications via ntfy (https://ntfy.sh or self-hosted). Leave NTFY_TOPIC empty to disable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Scheduled runs are aborted after this many minutes.
JOB_TIMEOUT_MIN=30
