# Copy into Dokploy → your compose app → Environment (or into .env for local runs).

# ── App ──────────────────────────────────────────────────────────────────────
# The address you open zync at (the Cloudflare tunnel's public hostname). The only Host and Origin
# the app accepts, and what passkeys are bound to: changing it later means registering them again.
APP_URL=https://zync.example.com

# Host folder whose subfolders are your workspaces. Created/fixed for the app's user on start.
WORKSPACES_HOST_DIR=/srv/zync/workspaces

# Timezone for job schedules, unless a job sets its own.
TZ=Europe/Paris

# ── Access (zero trust) ──────────────────────────────────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token. The tunnel is the only way in.
CLOUDFLARE_TUNNEL_TOKEN=
# Zero Trust → Access → Applications → zync → Overview. With both set, every request must carry a
# valid Access token for this application; requests that went around Access are refused.
CF_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Optional: only accept Access tokens for this identity.
CF_ACCESS_EMAIL=
# Behind that, zync itself asks for a passkey. The first start prints a one-time setup code in the
# api log: open APP_URL/login, enter it, create your passkey, save the recovery codes.

# ── AI providers ─────────────────────────────────────────────────────────────
# Referenced as {env:NAME} in opencode/opencode.json (the AI server config seed).
CODEX_ILIAD_API_KEY=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
# opencode's built-in providers read these directly; set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Scheduled runs are aborted after this many minutes.
JOB_TIMEOUT_MIN=30

# Push notifications via ntfy (https://ntfy.sh or self-hosted): job runs and security alerts
# (sign-ins, lockouts, passkey changes). Empty NTFY_TOPIC = off. Use a long, random topic name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
