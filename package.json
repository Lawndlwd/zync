{
  "name": "zync",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.29"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:opencode": "sh scripts/dev-opencode.sh",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip"
  },
  "devDependencies": {
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.5.0",
    "typescript": "^7.0.2"
  }
}
